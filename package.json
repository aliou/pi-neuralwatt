{
  "name": "@aliou/pi-neuralwatt",
  "version": "0.19.2",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-neuralwatt"
  },
  "sideEffects": false,
  "exports": {
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./extensions/provider/index.ts",
      "./extensions/command-quotas/index.ts",
      "./extensions/quota-warnings/index.ts"
    ],
    "video": "https://assets.aliou.me/github/aliou/pi-neuralwatt/demo.mp4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "extensions",
    "dist",
    "schema.json",
    "CHANGELOG.md",
    "README.md",
    "!src/**/*.test.ts",
    "!extensions/**/*.test.ts"
  ],
  "dependencies": {
    "@aliou/pi-utils-settings": "^0.24.0",
    "@aliou/pi-utils-ui": "^0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.18.1",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^2.27.11",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^25.0.10",
    "husky": "^9.1.7",
    "ts-json-schema-generator": "^2.4.0",
    "tsdown": "^0.23.4",
    "tsx": "4.23.12",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:models": "tsx scripts/check-models.ts",
    "check:changesets": "tsx scripts/check-changesets.ts",
    "gen:schema": "pi-settings-schema -p src/config/types.ts -t NeuralwattConfig -o schema.json",
    "check:schema": "pi-settings-schema -p src/config/types.ts -t NeuralwattConfig -o schema.json --check",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "prepare": "[ -d .git ] && husky || true",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm changeset publish"
  },
  "packageManager": "pnpm@11.27.0",
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}

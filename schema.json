{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/NeuralwattConfig",
  "definitions": {
    "NeuralwattConfig": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "quotaCommand": {
          "$ref": "#/definitions/NeuralwattQuotaCommandConfig",
          "description": "Quota command feature."
        },
        "quotaWarnings": {
          "$ref": "#/definitions/NeuralwattQuotaWarningsConfig",
          "description": "Quota warning feature."
        },
        "subBarIntegration": {
          "$ref": "#/definitions/NeuralwattSubBarIntegrationConfig",
          "description": "Sub-bar/status-bar integration feature."
        },
        "provider": {
          "$ref": "#/definitions/NeuralwattProviderConfig",
          "description": "Provider behavior (API surface)."
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\d{1,15}(\\.\\d{1,15})?(\\.\\d{1,15})?$"
            }
          ],
          "description": "Config schema version, stamped by migrations. Current version: 0.12.0."
        }
      },
      "additionalProperties": false
    },
    "NeuralwattQuotaCommandConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Show the quota command (/neuralwatt:quota)."
        }
      },
      "additionalProperties": false
    },
    "NeuralwattQuotaWarningsConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Show quota warnings when credits or energy are low."
        }
      },
      "additionalProperties": false
    },
    "NeuralwattSubBarIntegrationConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Show usage in the sub-bar / status bar."
        }
      },
      "additionalProperties": false
    },
    "NeuralwattProviderConfig": {
      "type": "object",
      "properties": {
        "api": {
          "$ref": "#/definitions/NeuralwattApi",
          "description": "Which API serves model requests."
        }
      },
      "additionalProperties": false
    },
    "NeuralwattApi": {
      "type": "string",
      "enum": [
        "openai-completions",
        "anthropic-messages"
      ],
      "description": "Neuralwatt serves every chat model twice: on an OpenAI-compatible `chat/completions` endpoint and on a vLLM-backed Anthropic-compatible `POST /v1/messages` endpoint. Exactly one serves the provider at a time."
    }
  }
}
